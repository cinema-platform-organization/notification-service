<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>Email Change Confirmation Code</title>
	</head>
	<body style="margin: 0; padding: 0; font-family: Arial, sans-serif;">
		<table style="width: 100%;" cellpadding="0" cellspacing="0">
			<tr>
				<td align="center" style="padding: 40px;">
					{{! <table style="width: 100%;"></table> }}
					<h1
						style="font-size: 22px; font-weight:bold;margin: 0 0 25px;"
					>
						Email change confirmation code
					</h1>
					<p style="font-size: 15px; margin: 0 0 15px;">Your code:
					</p>
					<div
						style="font-size: 36px;font-weight:bold;
    letter-spacing: 6px; margin: 18px 0;"
					>
						{{code}}
					</div>
					<p style="font-size:13px; color:#555; margin:30px 0 0;">
						If this wasn't you — just ignore this email.
					</p>
				</td>
			</tr>
		</table>
	</body>
</html>